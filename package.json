{
  "name": "@auto-tournament/ui",
  "version": "0.7.0",
  "description": "Auto Tournament's design system: tokens, themes and shared components.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Auto-Tournament/design-system.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.3.6",
    "@phosphor-icons/react": "^2.1.10",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.7",
    "motion": "^12.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "peerDependencies": {
    "@mui/material": "^7.0.0 || ^9.0.0",
    "@phosphor-icons/react": "^2.1.0",
    "motion": "^12.0.0 || ^13.0.0",
    "react": "^18.2.0 || ^19.0.0"
  }
}
